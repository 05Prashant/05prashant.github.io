---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';

const allWork = await getCollection('work', ({ data }) => !data.draft);
const sortedWork = allWork.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Work" description="Portfolio of Prashant Khanchandani, Staff Product Designer">
  <div class="container page-content">
    <p class="index-headline">
      I've spent the last decade crafting, building, and shipping digital experiences.
    </p>
    <ul class="work-list" role="list">
      {sortedWork.map((entry) => (
        <li class="work-card">
          <div class="work-card-text">
            <a href={`/work/${entry.id}`} class="work-card-link">
              {entry.data.title} <span aria-hidden="true">→</span>
            </a>
            <span class="work-card-company">{entry.data.company}</span>
          </div>
          <div class="work-card-images">
            <Image
              src={entry.data.cardImage}
              alt={entry.data.title}
              class="card-image-main"
            />
            {entry.data.cardImageSecondary && (
              <Image
                src={entry.data.cardImageSecondary}
                alt=""
                class="card-image-secondary"
              />
            )}
          </div>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .page-content {
    padding-top: 4rem;
    padding-bottom: 6rem;
  }

  .index-headline {
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    font-weight: 600;
    line-height: 1.4;
    max-width: 680px;
    margin-bottom: 4rem;
    color: var(--color-text);
  }

  .work-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 5rem;
  }

  .work-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .work-card {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      align-items: start;
    }
  }

  .work-card-text {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .work-card-link {
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    font-weight: 600;
    color: var(--color-text);
    transition: color 0.15s ease;
  }

  .work-card-link:hover {
    color: var(--color-accent);
  }

  .work-card-company {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .work-card-images {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 0.5rem;
  }

  .card-image-main,
  .card-image-secondary {
    width: 100%;
    height: auto;
    border-radius: 4px;
    display: block;
    object-fit: cover;
    aspect-ratio: 4 / 3;
  }

  .card-image-secondary {
    filter: brightness(0.75);
  }
</style>
