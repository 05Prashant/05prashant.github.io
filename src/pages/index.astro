---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import avatar from '../assets/avatar.jpg';

const allWork = await getCollection('work', ({ data }) => !data.draft);
const sortedWork = allWork.sort((a, b) => a.data.order - b.data.order);

const allPosters = await getCollection('posters', ({ data }) => !data.draft);
const sortedPosters = allPosters.sort((a, b) => a.data.order - b.data.order);

const allWriting = await getCollection('writing', ({ data }) => !data.draft);
const sortedWriting = allWriting.sort((a, b) => a.data.order - b.data.order);

const experience = [
  { role: 'Staff Product Designer', company: 'Docker', dates: '2022 - Now' },
  { role: 'Senior Product Designer', company: 'Preply', dates: '2021 - 2022' },
  { role: 'UX Designer', company: 'Booking.com', dates: '2016 - 2021' },
  { role: 'Product Designer', company: 'Cleartrip', dates: '2013 - 2016' },
  { role: 'Freelance Full-Stack Developer', company: 'Self', dates: 'Before 2013' },
];

const education = {
  role: 'Bachelor of Engg. (Computer Science)',
  company: 'Thadomal Shahani Engg. College',
  dates: '2012',
};
---

<BaseLayout title="Staff Product Designer" description="Portfolio of Prashant Khanchandani, Staff Product Designer">
  <div class="container page-content">

    <header class="header">
      <div class="name-row">
        <Image
          src={avatar}
          alt="Prashant Khanchandani"
          class="avatar"
          width={40}
          height={40}
          densities={[1, 2, 3]}
        />
        <h1 class="name">Prashant Khanchandani</h1>
      </div>
      <p class="bio">
        I am a product designer with 14+ years of experience building products for companies like Docker, Preply, and Booking.com.
        I started my career as a full-stack developer, and I'm very comfortable in the terminal. 
        I focus on first-principles and believe a good product is a lagging metric of a healthy team.
      </p>
    </header>

    <section class="section">
      <h2>Selected Work</h2>
      <ul class="link-list" role="list">
        {sortedWork.map((entry) => (
          <li>
            <a href={`/work/${entry.id}`} class="entry-link">
              {entry.data.title}
              <span class="entry-meta">{entry.data.company} - {entry.data.year}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="section">
      <h2>Posters</h2>
      <a href="/posters" class="poster-group-link">
        <ul class="poster-list" role="list">
          {sortedPosters.map((entry) => (
            <li>
              <Image
                src={entry.data.images[0]}
                alt={entry.data.title}
                class="poster-thumb"
                height={120}
                densities={[1, 2, 3]}
              />
            </li>
          ))}
        </ul>
      </a>
    </section>

    <section class="section">
      <h2>Writing</h2>
      <ul class="link-list" role="list">
        {sortedWriting.map((entry) => (
          <li>
            <a href={`/writing/${entry.id}`} class="entry-link">
              {entry.data.title}
              <span class="entry-meta">
                {entry.data.date.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="section">
      <h2>Experience</h2>
      <ul class="experience-list" role="list">
        {[...experience, education].map((item) => (
          <li class="experience-row">
            <span class="experience-dates">{item.dates}</span>
            <div class="experience-role">
              <span class="role-title">{item.role}</span>
              <span class="role-org">{item.company}</span>
            </div>
          </li>
        ))}
      </ul>
    </section>

  </div>
</BaseLayout>

<style>
  .page-content {
    padding-top: 4rem;
    padding-bottom: 6rem;
  }

  .header {
    margin-bottom: 5rem;
  }

  .name-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .name {
    margin-bottom: 0;
  }

  .bio {
    color: var(--color-text-muted);
  }

  .section {
    margin-bottom: 3.5rem;
  }

  .section h2 {
    margin-bottom: 1.5rem;
  }

  .link-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .entry-link {
    display: block;
    color: var(--color-text);
  }

  a.entry-link {
    position: relative;
    isolation: isolate;
  }

  a.entry-link::before {
    content: '';
    position: absolute;
    inset: -0.4rem -0.6rem;
    border-radius: 4px;
    background-color: transparent;
    transition: background-color 0.15s ease;
    z-index: -1;
  }

  a.entry-link:hover::before {
    background-color: rgba(0, 0, 0, 0.08);
  }

  .entry-static {
    cursor: default;
  }

  .entry-meta {
    display: block;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .poster-group-link {
    position: relative;
    isolation: isolate;
    display: block;
  }

  .poster-group-link::before {
    content: '';
    position: absolute;
    inset: -0.75rem;
    border-radius: 4px;
    background-color: transparent;
    transition: background-color 0.15s ease;
    z-index: -1;
  }

  .poster-group-link:hover::before {
    background-color: rgba(0, 0, 0, 0.08);
  }

  .poster-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .poster-thumb {
    height: 120px;
    width: auto;
    border-radius: 4px;
    display: block;
  }

  .experience-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .experience-row {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 1rem;
  }

  .experience-dates {
    color: var(--color-text-muted);
  }

  .experience-role {
    display: flex;
    flex-direction: column;
  }

  .role-title {
    color: var(--color-text);
  }

  .role-org {
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 480px) {
    .experience-row {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }

</style>
