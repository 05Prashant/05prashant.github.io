---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BackLink from '../../components/BackLink.astro';

export async function getStaticPaths() {
  const entries = await getCollection('work', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const allWork = await getCollection('work', ({ data }) => !data.draft);
const otherWork = allWork
  .filter((item) => item.id !== entry.id)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article class="case-study">
    <div class="container page-content">

      <div class="case-back">
        <BackLink />
      </div>

      <div
        class="case-hero"
        style={entry.data.heroBackground ? `background-color: ${entry.data.heroBackground}; padding: 20px 10px;` : undefined}
      >
        <Image
          src={entry.data.heroImage}
          alt={entry.data.title}
          class="hero-image"
        />
      </div>

      <div class="case-header">
        <h1>{entry.data.title}</h1>
        <p class="case-meta">{entry.data.company} - {entry.data.year}</p>
      </div>

      <div class="case-body prose">
        <Content />
      </div>

      {otherWork.length > 0 && (
        <div class="case-more">
          <h2>More work</h2>
          <ul class="link-list" role="list">
            {otherWork.map((item) => (
              <li>
                <a href={`/work/${item.id}`} class="entry-link">
                  {item.data.title}
                  <span class="entry-meta">{item.data.company} - {item.data.year}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

    </div>
  </article>
</BaseLayout>

<style>
  .case-study {
    padding-bottom: 6rem;
  }

  .case-back {
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
  }

  .case-hero {
    width: 100%;
    max-height: 520px;
    overflow: hidden;
    margin-bottom: 2.5rem;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 4px;
  }

  .case-header {
    text-align: center;
    padding-top: 1rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    margin-bottom: 3rem;
  }

  .case-header h1 {
    margin-bottom: 0.75rem;
  }

  .case-meta {
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .case-more {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }

  .case-more h2 {
    margin-bottom: 1.5rem;
  }

  .link-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .entry-link {
    display: block;
    color: var(--color-text);
  }

  a.entry-link {
    position: relative;
    isolation: isolate;
  }

  a.entry-link::before {
    content: '';
    position: absolute;
    inset: -0.4rem -0.6rem;
    border-radius: 4px;
    background-color: transparent;
    transition: background-color 0.15s ease;
    z-index: -1;
  }

  a.entry-link:hover::before {
    background-color: rgba(0, 0, 0, 0.08);
  }

  .entry-meta {
    display: block;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

</style>
