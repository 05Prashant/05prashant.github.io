---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BackLink from '../../components/BackLink.astro';

export async function getStaticPaths() {
  const entries = await getCollection('work', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article class="case-study">

    <div class="case-back container page-content">
      <BackLink />
    </div>

    <div
      class="case-hero container page-content"
      style={entry.data.heroBackground ? `background-color: ${entry.data.heroBackground}; padding-top: 20px; padding-bottom: 20px;` : undefined}
    >
      <Image
        src={entry.data.heroImage}
        alt={entry.data.title}
        class="hero-image"
      />
    </div>

    <div class="case-header container page-content">
      <h1>{entry.data.title}</h1>
      <p class="case-meta">{entry.data.company} - {entry.data.year}</p>
    </div>

    <div class="case-body container page-content prose">
      <Content />
    </div>

  </article>
</BaseLayout>

<style>
  .case-study {
    padding-bottom: 6rem;
  }

  .case-back {
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
  }

  .case-hero {
    width: 100%;
    max-height: 520px;
    overflow: hidden;
    margin-bottom: 2.5rem;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 4px;
  }

  .case-header {
    text-align: center;
    padding-top: 1rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    margin-bottom: 3rem;
  }

  .case-header h1 {
    margin-bottom: 0.75rem;
  }

  .case-meta {
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

</style>
